{
  "expo": {
    "name": "Natala",
    "slug": "natala",
    "scheme": "natala",
    "version": "0.21.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.natala.prototype"
    },
    "android": {
      "package": "app.natala.prototype",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "name": "Natala",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "expo-asset",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "62b88db7-75a7-49ff-974f-b6775165b842"
      }
    }
  }
}
