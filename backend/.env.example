# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgres://natala:natala@localhost:5432/natala?sslmode=disable
REDIS_URL=redis://localhost:6379
PORT=4000

# Local JWT signing secret (production uses keys from AWS Secrets Manager)
JWT_SECRET=change-me-local-only
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60

# Enables POST /v1/auth/dev to sign in as a seeded test user. Must be false in production.
DEV_LOGIN_ENABLED=true

# S3-compatible storage (local: leave empty to disable uploads)
S3_BUCKET=
S3_REGION=eu-central-1
