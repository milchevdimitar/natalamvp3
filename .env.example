# Copy to .env (Expo loads EXPO_PUBLIC_* variables at start).
# Testing on a phone with Expo Go? Use your computer's Wi-Fi IP, not localhost:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
# Seeded test user the app signs in as during development
EXPO_PUBLIC_DEV_LOGIN_EMAIL=ana@natala.local
